# Copy this to .env and fill in real values. Never commit the real .env.

# Local dev default matches docker-compose.yml as-is.
BOOK_EDITOR_DATABASE_URL=postgresql://book_editor:book_editor_dev_password@localhost:5432/book_editor

# Generate a real random secret, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
BOOK_EDITOR_JWT_SECRET=change-me-to-a-long-random-value

# AWS credentials are read from the standard boto3 chain (env vars / ~/.aws/credentials /
# instance role) — no separate app-specific AWS env vars needed unless you want to
# override the profile/region explicitly:
BOOK_EDITOR_AWS_REGION=us-east-1
BOOK_EDITOR_S3_BUCKET=mldatabase
BOOK_EDITOR_S3_PREFIX=AutomatedHtmlFlow

BOOK_EDITOR_CORS_ORIGINS_RAW=["http://localhost:5173"]
