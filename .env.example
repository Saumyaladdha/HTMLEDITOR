# Copy this file to `.env` (gitignored — never commit real credentials) and
# fill in real values. Used by book/util/upload_image.py to upload figure
# images to storage instead of leaving a chapter's figures as empty
# placeholder boxes.
#
# AV_UPLOAD_USER_ID / AV_UPLOAD_TOKEN come from the platform's phone/OTP
# login (see book/util/upload_image.py's module docstring for the three
# curl calls that flow is built from) — a human step outside this pipeline;
# the token is short-lived and needs refreshing here when it expires.
AV_UPLOAD_USER_ID=
AV_UPLOAD_TOKEN=

# Where uploaded figures are stored. Defaults to "book-figures" if unset.
AV_UPLOAD_FOLDER=book-figures
